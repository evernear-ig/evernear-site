# Copia este archivo a .env.local y completa los valores

# URL base de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos (configurar cuando se elija proveedor)
# DATABASE_URL=

# Autenticación (configurar cuando se implemente)
# AUTH_SECRET=

# Chat de Evernear — opción A (recomendada en local, gratis):
# Creá una clave en https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash

# Opción B: Vercel AI Gateway (requiere tarjeta para activar créditos).
# npx vercel login && npx vercel ai-gateway api-keys create --name evernear-local
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=google/gemini-3.8-flash
